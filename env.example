# Copia este archivo como .env.local y configura tus valores

# =============================================================================
# AMBIENTES — URLs base de la app por entorno
# =============================================================================
# Local:       http://localhost:3000          (npm run dev)
# Test:        https://brocha.vercel.app      (preview en Vercel)
# Producción:  https://...                   (pendiente, mismo proyecto u otro)
#
# En Vercel → Project → Settings → Environment Variables:
# - Preview:     NEXT_PUBLIC_APP_URL = https://brocha.vercel.app
# - Production:  NEXT_PUBLIC_APP_URL = https://tu-dominio-prod.com (cuando exista)
# =============================================================================

# App (elige según ambiente: local, test o producción)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=TBT

# Opcional: forzar entorno (local | test | production). Si no se define, se infiere de NEXT_PUBLIC_APP_URL
# NEXT_PUBLIC_APP_ENV=local

# Supabase (obtener de https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (obtener de https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# Twilio (para MMS con imagen del certificado)
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=+1234567890

# AWS SNS (fallback para SMS sin imagen)
# AWS_REGION=us-east-2
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# SendGrid (para emails de confirmación)
# SENDGRID_API_KEY=SG.your-sendgrid-api-key
# SENDGRID_FROM_EMAIL=noreply@yourdomain.com
# SENDGRID_FROM_NAME=TBT - Token Basado en Trabajo

# Gemini AI (context generation)
GEMINI_API_KEY=your-gemini-api-key

# Solana
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PAYER_PRIVATE_KEY=your-payer-private-key
SOLANA_PAYER_PUBLIC_KEY=your-payer-public-key
WALLET_ENCRYPTION_KEY=your-32-byte-hex-key

# Dev accounts (solo activos en NODE_ENV=development, nunca en producción)
# DEV_PHONE_1=1234567890
# DEV_EMAIL_1=dev@example.com
# DEV_PHONE_2=0987654321
# DEV_EMAIL_2=dev2@example.com

# Google Sheets (opcional, para logging)
# GOOGLE_SHEETS_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# GOOGLE_SHEETS_PRIVATE_KEY=your-private-key
# GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id
